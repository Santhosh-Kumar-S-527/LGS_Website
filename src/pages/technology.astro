---
// src/pages/technology.astro
import Layout from '../layouts/Layout.astro';

// Technology Domains Data
const techDomains = [
  {
    id: "ai-ml",
    step: "01",
    name: "AI & ML",
    category: "INTELLIGENCE",
    headline: "Neural Telemetry & Real-Time Inferencing",
    desc: "Deploying quantized computer vision models, predictive maintenance neural nets, and localized LLM inference engines operating directly on edge hardware.",
    capabilities: [
      "Edge Model Quantization & TensorRT Optimization",
      "Real-Time Anomaly Detection Telemetry",
      "Distributed Model Ingestion & Retraining Pipelines",
      "Sub-20ms On-Device Inferencing"
    ],
    stack: ["PyTorch", "ONNX Runtime", "CUDA", "TensorRT"],
    metric: "< 18ms",
    metricLabel: "INFERENCE TIME"
  },
  {
    id: "web-apps",
    step: "02",
    name: "Web Apps",
    category: "HIGH-CONCURRENCY",
    headline: "Deterministic Enterprise Web Platforms",
    desc: "Engineered with strict TypeScript type systems, zero-hydration islands, and reactive architectures designed to support thousands of active sessions without latency drag.",
    capabilities: [
      "Server-Driven Micro-Frontends",
      "High-Throughput WebSocket Streaming",
      "State Normalization & Memory Isolation",
      "WCAG 2.2 AA Enterprise Compliance"
    ],
    stack: ["Astro", "React", "TypeScript", "Tailwind CSS"],
    metric: "99.99%",
    metricLabel: "RENDER RELIABILITY"
  },
  {
    id: "mobile-apps",
    step: "03",
    name: "Mobile Apps",
    category: "EMBEDDED & EDGE",
    headline: "Industrial Mobile Companions & Telematics",
    desc: "Low-footprint mobile applications interfacing with industrial sensors, microcontrollers, and field controllers across offline-first and unstable networks.",
    capabilities: [
      "CAN Bus & Bluetooth Low Energy Synchronization",
      "Encrypted Local SQLite & Indexed Persistence",
      "Background Telematics & Geofence Sync",
      "Cross-Platform Deterministic Logic"
    ],
    stack: ["Kotlin", "Swift", "React Native", "BLE"],
    metric: "100%",
    metricLabel: "OFFLINE OPERATIONAL"
  },
  {
    id: "cloud",
    step: "04",
    name: "Cloud",
    category: "DISTRIBUTED SYSTEMS",
    headline: "High-Availability Multi-Region Topologies",
    desc: "Resilient cloud infrastructure with zero single points of failure, automatic geographic failover, and sub-millisecond container communication.",
    capabilities: [
      "Kubernetes Multi-Region Mesh Orchestration",
      "Infrastructure-as-Code with Terraform",
      "Zero-Trust Service-to-Service Networking",
      "Automated Disaster Recovery & Rollbacks"
    ],
    stack: ["AWS", "Docker", "Kubernetes", "Terraform"],
    metric: "99.98%",
    metricLabel: "UPTIME SLA"
  },
  {
    id: "data",
    step: "05",
    name: "Data",
    category: "ANALYTICS & STREAMS",
    headline: "High-Throughput Ingestion & Time-Series Engines",
    desc: "Scalable data ingestion pipelines aggregating millions of continuous sensor pulses, transaction logs, and operational telemetry per second.",
    capabilities: [
      "Event-Driven Pub/Sub Ingestion Streams",
      "Real-Time Columnar Time-Series Querying",
      "Strict Schema Evolution & Validation",
      "Zero-Data-Loss Backup Protocols"
    ],
    stack: ["ClickHouse", "Apache Kafka", "Redis", "PostgreSQL"],
    metric: "140M+",
    metricLabel: "EVENTS / DAY"
  },
  {
    id: "automation",
    step: "06",
    name: "Automation",
    category: "ROBOTICS & WORKFLOWS",
    headline: "Deterministic Industrial Automation Pipelines",
    desc: "Software systems orchestrating hardware controllers, factory-floor robotics, and critical background workflows without human bottlenecks.",
    capabilities: [
      "Deterministic State-Machine Workflow Engines",
      "Hardware Controller & PLC Handshakes",
      "Automated CI/CD Verification Gates",
      "Fault-Tolerant Retry & Compensation Flows"
    ],
    stack: ["Python", "FastAPI", "CAN Bus", "Celery"],
    metric: "0.00%",
    metricLabel: "PIPELINE DEADLOCKS"
  },
  {
    id: "ux-ui",
    step: "07",
    name: "UX/UI",
    category: "HUMAN ERGONOMICS",
    headline: "High-Density Operations & Mission-Control Interfaces",
    desc: "Clean, high-contrast operational dashboards engineered for continuous operator focus, zero visual confusion, and rapid crisis response.",
    capabilities: [
      "Ergonomic Dark Industrial Design Systems",
      "High-Density Telemetry Charting & Heatmaps",
      "Keyboard-First Navigation & Shortcut Bindings",
      "Sub-Millisecond UI Interaction States"
    ],
    stack: ["Design Tokens", "Figma", "Radix UI", "Canvas API"],
    metric: "44px",
    metricLabel: "MIN TARGET SIZE"
  }
];
---

<Layout
  title="Technology | Lingaasys Technologies"
  description="Explore the Lingaasys engineering stack: AI & ML, Web, Mobile, Cloud, Data, Automation, and Mission-Control UX/UI."
>
  <div class="relative w-full bg-[#050708] text-[#F7F8F8] font-['Sora',sans-serif] overflow-hidden selection:bg-[#E7430B] selection:text-white">

    {/* =========================================================================
        1. Hero Section
        ========================================================================= */}
    <section class="reveal relative min-h-[85vh] flex items-center justify-center py-32 sm:py-40 overflow-hidden bg-[#050708]">
      
      {/* Background Schematic with Full Coverage & Soft Edge Mask (Same method as About Hero) */}
      <div 
        class="absolute inset-0 z-0 pointer-events-none opacity-25"
        style="mask-image: radial-gradient(ellipse at center, black 50%, transparent 95%); -webkit-mask-image: radial-gradient(ellipse at center, black 50%, transparent 95%);"
      >
        <img 
          src="/images/technology/orange half circles.png" 
          alt="" 
          aria-hidden="true" 
          class="w-full h-full object-cover object-center"
        />
      </div>

      {/* Ambient Orange Glow Behind Headline */}
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
        <div class="w-[500px] h-[250px] bg-[#E7430B]/15 blur-[140px] rounded-full"></div>
      </div>

      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
        <div>
        </div>

        <h1 class="font-['Space_Grotesk',sans-serif] font-light text-4xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.1] text-[#F7F8F8] max-w-4xl mx-auto">
          Engineering deterministic platforms from <span class="font-medium text-[#E7430B]">silicon to cloud.</span>
        </h1>

        <p class="max-w-2xl mx-auto text-base sm:text-lg text-[#C8CDD0] leading-relaxed">
          We unify low-latency machine learning inferencing, fault-tolerant cloud microservices, and high-density telemetry interfaces into integrated industrial systems.
        </p>
      </div>
    </section>

    {/* =========================================================================
        2. Interactive Workbench: Category Tabs + Dual-Pane Deep Dive
        ========================================================================= */}
    <section class="reveal relative pt-16 pb-8 sm:pt-20 sm:pb-10 bg-[#050708] overflow-hidden">
      {/* Scattered Ambient Orange Glow - Top Right */}
      <div class="absolute -right-36 top-0 w-[500px] h-[500px] bg-[#E7430B]/10 rounded-full blur-[150px] pointer-events-none z-0"></div>

      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 space-y-12 relative z-10">
        
        {/* Section Heading */}
        <div class="max-w-2xl space-y-2">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#E7430B]">
            INTERACTIVE WORKBENCH
          </span>
          <h2 class="text-3xl sm:text-4xl font-light font-['Space_Grotesk',sans-serif] tracking-tight">
            Select a <span class="font-medium text-[#E7430B]">Capability Area</span>
          </h2>
        </div>

        {/* Tab Navigation Strip */}
        <div class="flex items-center gap-2 overflow-x-auto pb-4 border-b border-[#293036] scrollbar-none" role="tablist">
          {techDomains.map((domain, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-btn-${domain.id}`}
              data-tab={domain.id}
              aria-selected={index === 0 ? "true" : "false"}
              class:list={[
                "tab-trigger px-5 py-2.5 rounded-full text-xs font-['Space_Grotesk',sans-serif] font-medium tracking-wide whitespace-nowrap transition-all border",
                index === 0 
                  ? "bg-[#E7430B] text-white border-[#E7430B] shadow-[0_0_20px_rgba(231,67,11,0.3)]" 
                  : "bg-[#111519] text-[#818A90] border-[#293036] hover:text-white hover:border-[#3B444B]"
              ]}
            >
              {domain.name}
            </button>
          ))}
        </div>

        {/* Tab Panels Container */}
        <div class="relative min-h-[480px]">
          {techDomains.map((domain, index) => (
            <div
              id={`panel-${domain.id}`}
              role="tabpanel"
              class:list={[
                "tab-panel transition-all duration-300",
                index === 0 ? "block" : "hidden"
              ]}
            >
              <div class="p-8 sm:p-12 rounded-[24px] bg-[#050708] border border-[#293036] grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                
                {/* Left Pane: Architecture Specs */}
                <div class="lg:col-span-7 space-y-6">
                  <div class="flex items-center gap-3">
                    <span class="font-['Roboto_Mono',monospace] text-sm text-[#E7430B] font-bold">
                      {domain.step}/
                    </span>
                    <span class="text-[11px] font-['Roboto_Mono',monospace] px-2.5 py-1 rounded-full bg-[#171C20] border border-[#293036] text-[#818A90]">
                      {domain.category}
                    </span>
                  </div>

                  <h3 class="text-2xl sm:text-3xl font-light font-['Space_Grotesk',sans-serif] text-white tracking-tight">
                    {domain.headline}
                  </h3>

                  <p class="text-sm sm:text-base text-[#C8CDD0] leading-relaxed font-['Sora',sans-serif]">
                    {domain.desc}
                  </p>

                  {/* Capabilities List */}
                  <div class="space-y-3 pt-2">
                    <span class="text-xs uppercase font-mono text-[#818A90] tracking-wider">
                      CORE CAPABILITIES
                    </span>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                      {domain.capabilities.map((cap) => (
                        <div class="flex items-start gap-2 text-xs text-[#C8CDD0]">
                          <span class="text-[#E7430B] font-mono mt-0.5">▸</span>
                          <span>{cap}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* Stack Badges */}
                  <div class="pt-4 flex flex-wrap items-center gap-2">
                    {domain.stack.map((item) => (
                      <span class="text-xs font-mono px-3 py-1 rounded bg-[#111519] border border-[#293036] text-[#818A90]">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>

                {/* Right Pane: Benchmark Box */}
                <div class="lg:col-span-5 flex flex-col justify-center">
                  <div class="p-8 rounded-[20px] bg-[#0B0E10] border border-[#3B444B] space-y-6 relative overflow-hidden">
                    <div class="absolute -top-12 -right-12 w-36 h-36 bg-[#E7430B]/15 rounded-full blur-2xl pointer-events-none"></div>

                    <div class="space-y-2">
                      <span class="text-xs font-mono text-[#818A90] uppercase tracking-widest">
                        BENCHMARK SPECIFICATION
                      </span>
                      <div class="font-['Space_Grotesk',sans-serif] text-5xl font-light text-white tracking-tight">
                        {domain.metric}
                      </div>
                      <p class="text-xs text-[#818A90] font-mono">
                        {domain.metricLabel}
                      </p>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* =========================================================================
        3. Full Domain Matrix (7-Card Grid with Subtle Card Backgrounds)
        ========================================================================= */}
    <section class="reveal relative pt-8 pb-20 sm:pt-10 sm:pb-28 bg-[#050708] overflow-hidden">
      {/* Scattered Ambient Orange Glow - Bottom Left */}
      <div class="absolute -left-32 top-1/3 w-[600px] h-[600px] bg-[#E7430B]/10 rounded-full blur-[160px] pointer-events-none z-0"></div>

      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 space-y-16 relative z-10">
        
        {/* Header */}
        <div class="max-w-2xl space-y-3">
          <span class="text-xs font-bold uppercase tracking-[0.12em] text-[#E7430B]">
            ALL DOMAINS
          </span>
          <h2 class="text-3xl sm:text-4xl font-light font-['Space_Grotesk',sans-serif] tracking-tight">
            Complete Technology <span class="font-medium text-[#E7430B]">Matrix</span>
          </h2>
          <p class="text-sm sm:text-base text-[#818A90]">
            Every architectural specialization engineered with deterministic rigor and high operational viability.
          </p>
        </div>

        {/* 7-Card Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {techDomains.map((domain, index) => (
            <div 
              class:list={[
                "relative p-8 sm:p-10 rounded-[24px] bg-[#0B0E10] border border-[#293036] hover:border-[#E7430B]/60 transition-all duration-500 overflow-hidden flex flex-col justify-between space-y-8 group shadow-[0_18px_48px_rgba(0,0,0,0.4)]",
                index === 6 ? "md:col-span-2 lg:col-span-3" : ""
              ]}
            >
              {/* Subtle Card Background Image - Covers Entire Card Seamlessly */}
              <img
                src="/images/about/card-wave-bg.png"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none opacity-20 group-hover:opacity-50 group-hover:scale-105 transition-all duration-700 ease-out z-0 filter contrast-120"
              />

              {/* Uniform Subtle Vignette for Full-Card Background Visibility & Text Contrast */}
              <div class="absolute inset-0 bg-radial from-transparent via-[#0B0E10]/40 to-[#0B0E10]/85 pointer-events-none z-0"></div>

              {/* Dynamic Orange Glow on Hover */}
              <div class="absolute -bottom-12 -right-12 w-48 h-48 rounded-full bg-[#E7430B]/0 group-hover:bg-[#E7430B]/20 blur-3xl transition-all duration-500 pointer-events-none z-0"></div>

              {/* Foreground Details */}
              <div class="relative z-10 space-y-6">
                <div class="flex items-center justify-between">
                  <span class="font-['Roboto_Mono',monospace] text-sm text-[#E7430B] font-bold">
                    {domain.step}/
                  </span>
                  <span class="text-[11px] font-['Roboto_Mono',monospace] px-2.5 py-1 rounded bg-[#171C20]/80 backdrop-blur-sm text-[#818A90] border border-[#293036]">
                    {domain.category}
                  </span>
                </div>

                <div class="space-y-1.5">
                  <h3 class="text-2xl font-medium font-['Space_Grotesk',sans-serif] text-white">
                    {domain.name}
                  </h3>
                  <div class="text-xs font-mono text-[#E7430B]">
                    {domain.headline}
                  </div>
                </div>

                <p class="text-sm text-[#C8CDD0] leading-relaxed">
                  {domain.desc}
                </p>
              </div>

              {/* Bottom Card Row */}
              <div class="relative z-10 pt-4 border-t border-[#293036]/50 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                  {domain.stack.slice(0, 2).map((s) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#171C20] text-[#818A90] border border-[#293036]">
                      {s}
                    </span>
                  ))}
                </div>
                <span class="text-xs font-mono text-[#818A90] group-hover:text-[#E7430B] transition-colors">
                  {domain.metric}
                </span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    {/* =========================================================================
        4. Architectural Assurance Strip
        ========================================================================= */}
    <section class="reveal relative py-16 bg-[#050708] overflow-hidden">
      {/* Scattered Ambient Orange Glow - Bottom Center */}
      <div class="absolute left-1/2 -translate-x-1/2 bottom-0 w-[700px] h-[300px] bg-[#E7430B]/12 rounded-full blur-[160px] pointer-events-none z-0"></div>

      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="space-y-1">
            <span class="text-xs font-mono text-[#E7430B]">01 / LATENCY</span>
            <div class="font-['Space_Grotesk',sans-serif] text-2xl font-bold text-white">&lt; 40ms Edge</div>[cite: 1]
            <p class="text-xs text-[#818A90]">Global endpoint average</p>
          </div>
          <div class="space-y-1">
            <span class="text-xs font-mono text-[#E7430B]">02 / TYPE SAFETY</span>
            <div class="font-['Space_Grotesk',sans-serif] text-2xl font-bold text-white">Strict TypeScript</div>
            <p class="text-xs text-[#818A90]">Zero-any codebase policy</p>
          </div>
          <div class="space-y-1">
            <span class="text-xs font-mono text-[#E7430B]">03 / SECURITY</span>
            <div class="font-['Space_Grotesk',sans-serif] text-2xl font-bold text-white">ISO 27001</div>
            <p class="text-xs text-[#818A90]">Enterprise standard aligned</p>
          </div>
          <div class="space-y-1">
            <span class="text-xs font-mono text-[#E7430B]">04 / TESTING</span>
            <div class="font-['Space_Grotesk',sans-serif] text-2xl font-bold text-white">Automated CI/CD</div>
            <p class="text-xs text-[#818A90]">Deterministic build gates</p>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* Scroll reveal animation base */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* Keyframe entrance animation for workbench tab panels */
  @keyframes tabContentEntrance {
    0% {
      opacity: 0;
      transform: translateY(18px) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .tab-panel-active {
    animation: tabContentEntrance 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .tab-panel-active {
      animation: none;
    }
  }
</style>

<script>
  // Tab switching logic for the Interactive Workbench with entrance animation
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-trigger');
  const tabPanels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-tab');

      // Update button styling
      tabButtons.forEach((b) => {
        b.setAttribute('aria-selected', 'false');
        b.className = "tab-trigger px-5 py-2.5 rounded-full text-xs font-['Space_Grotesk',sans-serif] font-medium tracking-wide whitespace-nowrap transition-all border bg-[#111519] text-[#818A90] border-[#293036] hover:text-white hover:border-[#3B444B]";
      });

      btn.setAttribute('aria-selected', 'true');
      btn.className = "tab-trigger px-5 py-2.5 rounded-full text-xs font-['Space_Grotesk',sans-serif] font-medium tracking-wide whitespace-nowrap transition-all border bg-[#E7430B] text-white border-[#E7430B] shadow-[0_0_20px_rgba(231,67,11,0.3)]";

      // Toggle panel visibility with entrance animation trigger
      tabPanels.forEach((panel) => {
        if (panel.id === `panel-${targetId}`) {
          panel.classList.remove('hidden');
          panel.classList.add('block', 'tab-panel-active');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('block', 'tab-panel-active');
        }
      });
    });
  });

  // Intersection Observer for scroll entrance
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('active');
        obs.unobserve(entry.target);
      }
    });
  }, { root: null, rootMargin: '0px 0px -60px 0px', threshold: 0.15 });

  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>