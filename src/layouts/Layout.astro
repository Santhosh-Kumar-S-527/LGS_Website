---
// src/layouts/Layout.astro
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Chatbot from '../components/common/Chatbot.astro';
import ContactModal from '../components/layout/ContactModal.astro';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lingaasys | Creating Systems for Humanity",
  description = "Lingaasys is a technology engineering partner delivering software that powers people, industries, and aspirations."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Space Grotesk (Headings), Sora (Body), Roboto Mono (Utility) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500&family=Sora:wght@400;600;700&family=Space+Grotesk:wght@300;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-[#050708] text-[#F7F8F8] font-['Sora',sans-serif] antialiased selection:bg-[#E7430B] selection:text-white">
    {/* Global Header & Nav Shell */}
    <Navbar />

    {/* Primary Routed View Content Slot */}
    <main class="flex-1 w-full relative z-10">
      <slot />
    </main>

    {/* Global Footer & CTA */}
    <Footer />

    {/* Floating Chatbot Island (Pinned Bottom-Right) */}
    <aside class="fixed bottom-6 right-6 z-50 pointer-events-auto" aria-label="Support Assistant">
      <Chatbot client:idle />
    </aside>

    {/* Global Contact Modal / Drawer */}
    <ContactModal client:idle />
  </body>
</html>