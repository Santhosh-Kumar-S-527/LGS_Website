---
// src/components/common/Chatbot.astro
// Floating AI/Robot Assistant Widget
---

<!-- Fixed Floating Launcher & Chat Window Container -->
<aside class="fixed bottom-6 right-6 z-50 flex flex-col items-end pointer-events-none font-['Sora',sans-serif]">
  
  {/* 1. Chat Dialog Box */}
  <div
    id="chatbot-window"
    role="dialog"
    aria-label="Lingaasys AI Assistant"
    aria-hidden="true"
    class="pointer-events-auto opacity-0 translate-y-6 scale-95 pointer-events-none transition-all duration-300 ease-out origin-bottom-right mb-4 w-[90vw] max-w-[380px] h-[520px] max-h-[80vh] rounded-[24px] bg-[#0B0E10]/95 backdrop-blur-xl border border-[#293036] shadow-[0_24px_50px_rgba(0,0,0,0.7)] flex flex-col overflow-hidden"
  >
    {/* Header */}
    <header class="p-4 bg-[#111519] border-b border-[#293036] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="relative w-8 h-8 rounded-full bg-[#E7430B]/15 border border-[#E7430B]/30 flex items-center justify-center text-[#E7430B]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693l-1.57-.393m15.6 0A12.015 12.015 0 0112 18c-3.11 0-5.96-.92-8.35-2.5m15.95-.2l.6.6a1.5 1.5 0 010 2.12l-.6.6a1.5 1.5 0 01-2.12 0l-.6-.6" />
          </svg>
          <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-[#26CAD3] ring-2 ring-[#0B0E10]"></span>
        </div>
        <div>
          <h3 class="text-sm font-semibold font-['Space_Grotesk',sans-serif] text-white flex items-center gap-1.5">
            Lingaasys Bot <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#171C20] text-[#E7430B] border border-[#293036]">AI</span>
          </h3>
        </div>
      </div>

      <button
        type="button"
        id="chatbot-close-btn"
        aria-label="Close Assistant"
        class="w-7 h-7 rounded-full flex items-center justify-center text-[#818A90] hover:text-white hover:bg-[#171C20] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#E7430B]"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </header>

    {/* Message Area */}
    <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-4 text-xs scrollbar-thin scrollbar-thumb-[#293036]">
      {/* Bot Greeting */}
      <div class="flex items-start gap-2.5">
        <div class="w-6 h-6 rounded-full bg-[#E7430B]/20 text-[#E7430B] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="p-3 rounded-2xl rounded-tl-sm bg-[#111519] border border-[#293036] text-[#C8CDD0] leading-relaxed max-w-[85%]">
          Hello! I am Lingaasys AI. How can I help you explore our industrial systems, AI models, or engineering teams?
        </div>
      </div>
    </div>

    {/* Input Form */}
    <form id="chat-form" class="p-3 bg-[#111519] border-t border-[#293036] flex items-center gap-2">
      <input
        type="text"
        id="chat-input"
        placeholder="Ask about technology, careers..."
        autocomplete="off"
        class="flex-1 bg-[#050708] border border-[#293036] rounded-full px-4 py-2 text-xs text-white placeholder-[#818A90] focus:outline-none focus:border-[#E7430B] transition-colors"
      />
      <button
        type="submit"
        aria-label="Send query"
        class="w-8 h-8 rounded-full bg-[#E7430B] hover:bg-[#F4511E] text-white flex items-center justify-center transition-transform hover:scale-105 flex-shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
      >
        <svg class="w-3.5 h-3.5 transform rotate-45 -translate-x-0.5 translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
      </button>
    </form>
  </div>

  {/* 2. Floating Circular Launcher Button */}
  <button
    type="button"
    id="chatbot-toggle-btn"
    aria-label="Open Chat Assistant"
    aria-expanded="false"
    class="pointer-events-auto relative group w-14 h-14 rounded-full bg-[#E7430B] hover:bg-[#F4511E] text-white shadow-[0_0_28px_rgba(231,67,11,0.45)] hover:shadow-[0_0_36px_rgba(231,67,11,0.65)] flex items-center justify-center transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#050708]"
  >
    {/* Pulse ring animation */}
    <span class="absolute inset-0 rounded-full bg-[#E7430B] opacity-75 animate-ping -z-10 group-hover:opacity-100"></span>

    {/* Robot / AI Icon */}
    <svg id="icon-open" class="w-6 h-6 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      {/* Robot Head */}
      <rect x="3" y="11" width="18" height="10" rx="3" stroke-width="2" />
      <circle cx="8.5" cy="15.5" r="1.5" fill="currentColor" />
      <circle cx="15.5" cy="15.5" r="1.5" fill="currentColor" />
      <path stroke-linecap="round" stroke-width="2" d="M12 2v4M8 6h8M2 15h1M21 15h1" />
    </svg>

    {/* Close Icon (Visible when active) */}
    <svg id="icon-close" class="w-6 h-6 hidden transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</aside>

<script>
  const toggleBtn = document.getElementById("chatbot-toggle-btn");
  const closeBtn = document.getElementById("chatbot-close-btn");
  const windowEl = document.getElementById("chatbot-window");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");
  const chatForm = document.getElementById("chat-form") as HTMLFormElement;
  const chatInput = document.getElementById("chat-input") as HTMLInputElement;
  const messagesContainer = document.getElementById("chat-messages");

  const toggleChat = (show?: boolean) => {
    const isVisible = show !== undefined ? !show : !windowEl?.classList.contains("opacity-0");

    if (isVisible) {
      // Close
      windowEl?.classList.add("opacity-0", "translate-y-6", "scale-95", "pointer-events-none");
      windowEl?.setAttribute("aria-hidden", "true");
      toggleBtn?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    } else {
      // Open
      windowEl?.classList.remove("opacity-0", "translate-y-6", "scale-95", "pointer-events-none");
      windowEl?.setAttribute("aria-hidden", "false");
      toggleBtn?.setAttribute("aria-expanded", "true");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      setTimeout(() => chatInput?.focus(), 150);
    }
  };

  toggleBtn?.addEventListener("click", () => toggleChat());
  closeBtn?.addEventListener("click", () => toggleChat(false));

  // Quick message handling
  chatForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const text = chatInput.value.trim();
    if (!text || !messagesContainer) return;

    // Append User Message
    const userMsg = document.createElement("div");
    userMsg.className = "flex items-start justify-end";
    userMsg.innerHTML = `
      <div class="p-3 rounded-2xl rounded-tr-sm bg-[#E7430B] text-white leading-relaxed max-w-[85%]">
        ${text}
      </div>
    `;
    messagesContainer.appendChild(userMsg);
    chatInput.value = "";
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    // Simulate AI Response
    setTimeout(() => {
      const botMsg = document.createElement("div");
      botMsg.className = "flex items-start gap-2.5";
      botMsg.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-[#E7430B]/20 text-[#E7430B] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="p-3 rounded-2xl rounded-tl-sm bg-[#111519] border border-[#293036] text-[#C8CDD0] leading-relaxed max-w-[85%]">
          Thank you for reaching out. An engineer from Lingaasys will review your message or you can reach us via our Contact form.
        </div>
      `;
      messagesContainer.appendChild(botMsg);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }, 600);
  });
</script>