---
// src/components/layout/Navbar.astro

const navLinks = [
  { name: "About", href: "/about" },
  { name: "Technology", href: "/technology" },
  { name: "Industry", href: "/industry" },
  { name: "Career", href: "/career" },
];

const currentPath = Astro.url.pathname;
---

<header class="w-full sticky top-0 z-40 bg-[#050708]/90 backdrop-blur-md border-b border-[#293036]">
  {/* 2. Main Navigation Bar */}
  <nav class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between" aria-label="Main Navigation">
    {/* Brand Logo using /logos/darkLogo 2.svg */}
    <a 
      href="/" 
      class="flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E7430B] rounded-sm py-1"
      aria-label="Lingaasys Home"
    >
      <img
        src="/logos/darkLogo 2.svg"
        alt="Lingaasys Logo"
        class="h-8 sm:h-9 w-auto object-contain"
        loading="eager"
      />
    </a>

    {/* Desktop Navigation Links */}
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                "text-sm font-medium tracking-wide transition-colors py-2 px-1 relative focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E7430B] rounded-sm",
                isActive ? "text-[#F7F8F8] font-semibold" : "text-[#C8CDD0] hover:text-[#F7F8F8]"
              ]}
            >
              {link.name}
              {isActive && (
                <span class="absolute bottom-0 left-0 w-full h-[2px] bg-[#E7430B] rounded-full"></span>
              )}
            </a>
          </li>
        );
      })}
    </ul>

    {/* Action & Mobile Menu Toggle */}
    <div class="flex items-center gap-4">
      {/* Mobile Hamburger Toggle Button */}
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden inline-flex items-center justify-center p-2.5 rounded-lg text-[#C8CDD0] hover:text-white hover:bg-[#111519] border border-[#293036] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E7430B]"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  {/* 3. Mobile Navigation Drawer */}
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[#293036] bg-[#0B0E10] px-6 py-6 transition-all duration-300"
  >
    <ul class="flex flex-col gap-4">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                "block py-2 text-base font-['Sora',sans-serif] transition-colors",
                isActive ? "text-[#E7430B] font-semibold" : "text-[#C8CDD0] hover:text-white"
              ]}
            >
              {link.name}
            </a>
          </li>
        );
      })}
    </ul>
    <div class="mt-6 pt-6 border-t border-[#293036]">
      <button
        type="button"
        id="mobile-contact-btn"
        class="w-full flex items-center justify-center min-h-[44px] px-6 py-3 rounded-full bg-[#E7430B] text-white font-['Sora',sans-serif] text-sm font-semibold tracking-wide"
      >
        Talk To Us
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile navigation drawer toggle
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  menuBtn?.addEventListener("click", () => {
    const isExpanded = menuBtn.getAttribute("aria-expanded") === "true";
    menuBtn.setAttribute("aria-expanded", String(!isExpanded));
    mobileMenu?.classList.toggle("hidden");
    hamburgerIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  // Global event dispatcher to open ContactModal
  const triggerContactModal = () => {
    window.dispatchEvent(new CustomEvent("open-contact-modal"));
  };

  document.getElementById("open-contact-btn")?.addEventListener("click", triggerContactModal);
  document.getElementById("mobile-contact-btn")?.addEventListener("click", triggerContactModal);
</script>