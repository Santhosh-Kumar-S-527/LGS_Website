---
// src/components/layout/Footer.astro

const companyLinks = [
  { name: "About us", href: "/about" },
  { name: "Careers", href: "/career" },
  { name: "Contact", href: "#contact" },
  { name: "Newsroom", href: "/newsroom" },
];

const solutionLinks = [
  { name: "AI Integration", href: "/technology#ai" },
  { name: "Data Analytics", href: "/technology#analytics" },
  { name: "Cloud Services", href: "/technology#cloud" },
  { name: "Security", href: "/technology#security" },
];

const industryLinks = [
  { name: "Healthcare", href: "/industry#healthcare" },
  { name: "Finance", href: "/industry#finance" },
  { name: "Retail", href: "/industry#retail" },
  { name: "Manufacturing", href: "/industry#manufacturing" },
];

const resourceLinks = [
  { name: "Case Studies", href: "/case-studies" },
  { name: "Blog", href: "/blog" },
  { name: "Whitepapers", href: "/whitepapers" },
  { name: "Support", href: "/support" },
];

const legalLinks = [
  { name: "Terms", href: "/terms" },
  { name: "Privacy Policy", href: "/privacy" },
  { name: "Cookies", href: "/cookies" },
];
---

<footer class="relative w-full bg-[#050708] border-t border-[#293036] text-[#F7F8F8] font-['Sora',sans-serif] overflow-hidden">
  {/* Diagonal Warm Accent Glow Backgrounds matching the reference image */}
  <div class="absolute -left-20 bottom-0 w-80 h-80 bg-gradient-to-tr from-[#E7430B]/20 via-[#E7430B]/5 to-transparent blur-3xl pointer-events-none"></div>
  <div class="absolute -right-20 bottom-0 w-80 h-80 bg-gradient-to-tl from-[#E7430B]/20 via-[#E7430B]/5 to-transparent blur-3xl pointer-events-none"></div>

  {/* Main Footer Container */}
  <div class="relative z-10 max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
      
      {/* Left Column: Call To Action & Send Message Pill */}
      <div class="lg:col-span-5 flex flex-col justify-between space-y-8 pr-0 lg:pr-8">
        <div class="space-y-3">
          <h2 class="text-3xl sm:text-4xl font-light font-['Space_Grotesk',sans-serif] text-[#F7F8F8] tracking-tight">
            Lets Build What’s <br />
            <span class="text-[#E7430B] font-medium">Together</span>
          </h2>
          <p class="text-sm text-[#818A90] font-['Sora',sans-serif] max-w-sm pt-2 leading-relaxed">
            Have a question, a project idea or just want to say hello? Lets hear from you
          </p>
        </div>

        {/* Pill Button with Circular Orange Arrow */}
        <div>
          <button
            type="button"
            id="footer-open-contact"
            class="group inline-flex items-center justify-between w-full max-w-[280px] h-[52px] pl-6 pr-2 rounded-full border border-[#293036] bg-[#0B0E10] hover:border-[#E7430B] transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E7430B]"
          >
            <span class="text-sm font-medium text-[#F7F8F8] group-hover:text-white transition-colors">
              Send Message
            </span>
            <span class="w-9 h-9 rounded-full bg-[#E7430B] flex items-center justify-center text-white transition-transform duration-300 group-hover:scale-105 group-hover:bg-[#F4511E]">
              <svg class="w-4 h-4 transform -rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
          </button>
        </div>
      </div>

      {/* Right Column: Logo & 4-Column Directory with Left Border Divider */}
      <div class="lg:col-span-7 flex flex-col space-y-10 pl-0 lg:pl-10 lg:border-l lg:border-[#293036]/60">
        {/* Brand Logo */}
        <div>
          <a href="/" class="inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#E7430B] rounded-sm">
            <img
              src="/logos/darkLogo 2.svg"
              alt="Lingaasys Logo"
              class="h-9 w-auto object-contain"
              loading="lazy"
            />
          </a>
        </div>

        {/* Navigation Link Columns */}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8">
          {/* Company */}
          <div class="space-y-4">
            <h4 class="text-sm font-semibold text-[#F7F8F8] font-['Space_Grotesk',sans-serif]">
              Company
            </h4>
            <ul class="space-y-2.5">
              {companyLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-[#818A90] hover:text-[#E7430B] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#E7430B]"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {/* Solutions */}
          <div class="space-y-4">
            <h4 class="text-sm font-semibold text-[#F7F8F8] font-['Space_Grotesk',sans-serif]">
              Solutions
            </h4>
            <ul class="space-y-2.5">
              {solutionLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-[#818A90] hover:text-[#E7430B] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#E7430B]"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {/* Industries */}
          <div class="space-y-4">
            <h4 class="text-sm font-semibold text-[#F7F8F8] font-['Space_Grotesk',sans-serif]">
              Industries
            </h4>
            <ul class="space-y-2.5">
              {industryLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-[#818A90] hover:text-[#E7430B] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#E7430B]"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {/* Resources */}
          <div class="space-y-4">
            <h4 class="text-sm font-semibold text-[#F7F8F8] font-['Space_Grotesk',sans-serif]">
              Resources
            </h4>
            <ul class="space-y-2.5">
              {resourceLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-xs text-[#818A90] hover:text-[#E7430B] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[#E7430B]"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Bottom Bar: Copyright and Legal */}
  <div class="border-t border-[#293036]/50 bg-[#050708]/80 backdrop-blur-sm">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-[12px] text-[#818A90]">
      <p>© Copyright 2026. All Rights Reserved.</p>
      <ul class="flex items-center gap-6">
        {legalLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-[#F7F8F8] transition-colors">
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<script>
  // Open ContactModal event listener
  document.getElementById("footer-open-contact")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("open-contact-modal"));
  });
</script>